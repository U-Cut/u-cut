{
  "name": "u-cut",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p packages/schema && tsc -p packages/engine",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "license-scan": "tsx scripts/license-scan.ts",
    "gen:swift": "tsx packages/schema/scripts/gen-swift.ts",
    "check": "biome check . && tsc -p tsconfig.check.json --noEmit && vitest run && tsx scripts/license-scan.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
